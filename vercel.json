{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)dashboard' ':(exclude)backups' ':(exclude).github'",
  "git": {
    "deploymentEnabled": { "claude/*": false }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/pt", "destination": "/pt/index.html" }
  ],
  "redirects": [
    { "source": "/blog-consulente-marketing-per-posizionamento-acquisition-ed-execution", "destination": "/consulente-marketing-pmi", "permanent": true },
    { "source": "/blog-consulenza-marketing-per-aziende-che-vogliono-crescere-meglio", "destination": "/servizi-marketing", "permanent": true },
    { "source": "/blog-strategia-marketing-per-pmi-e-aziende-in-fase-di-crescita", "destination": "/consulente-marketing-pmi", "permanent": true }
  ]
}
